{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data":{
    "url": "https://raw.githubusercontent.com/SeanMASilva/FIT3179-Datavis2/refs/heads/main/src/assets/bushfireChoropleth.csv",
    "name": "choropleth"
  },
  "params": [
    {
      "name": "decade",
      "value": 2000,
      "bind": {
        "input": "range",
        "min": 1930,
        "max": 2010,
        "step": 10,
        "name": "Decade"
      }
    }
  ],
  "title":{
    "text":"Map of Australia's Bushfires and Cyclones ",
    "fontSize":28,
    "font":"Lora",
    "fontWeight":600,
    "anchor": "start"
  },
  "width":500,
  "height":400,
  "projection": {
    "type":"azimuthalEqualArea", 
    "rotate":[-133.5,26,0], 
    "scale": 600
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/SeanMASilva/FIT3179-Datavis2/refs/heads/main/src/assets/baseWorldLarger.json",
        "format": {"type": "topojson", "feature": "ne_50m_land"}
      },
      "mark": {"type": "geoshape", "fill": "lightgrey", "stroke": "white"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/SeanMASilva/FIT3179-Datavis2/refs/heads/main/src/assets/baseWorldLarger.json",
        "format": {"type": "topojson", "feature": "ne_50m_ocean"}
      },
      "mark": {"type": "geoshape", "fill": "lightblue"}
    },
    {
      "data":{
        "url":"https://raw.githubusercontent.com/SeanMASilva/FIT3179-Datavis2/refs/heads/main/src/assets/baseWorldLarger.json",
        "format":{
          "type": "topojson",
          "feature": "ne_50m_admin_1_states_provinces"
        }
      },
      "transform": [
        {"filter": "datum.properties.iso_a2 == 'AU'"},
        {"calculate": "'Data is not available for ' + datum.properties.name + ' in ' + decade", "as": "tooltip"}
      ],
      "mark": {"type": "geoshape", "fill":"lightgrey", "stroke":"white", "strokeWidth":0.3},
      "encoding": {
        "tooltip":{"field":"tooltip"}
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/SeanMASilva/FIT3179-Datavis2/refs/heads/main/src/assets/baseWorldLarger.json",
        "format": {"type": "topojson", "feature": "ne_50m_admin_1_states_provinces_lines"}
      },
      "mark": {"type": "geoshape", "fill":"","stroke":"white"}
    },
    
    {
      "data": {
        "name": "choropleth",
        "format":{"type": "csv"}
        
      },
      "transform": [
        {
          "lookup": "State",
          "from":{
            "data":{
              "url":"https://raw.githubusercontent.com/SeanMASilva/FIT3179-Datavis2/refs/heads/main/src/assets/baseWorldLarger.json",
              "format":{
                "type": "topojson",
                "feature": "ne_50m_admin_1_states_provinces"
              }
            },
            "key": "properties.name"
            
          },
          "as":"geo"
        },
        {
          "filter": "datum.Decade == decade"
        },
        {
          "calculate": "datum.PercentBurnt * 100",
          "as": "PercentBurnt2"
        }
      ],
      "mark":{"type": "geoshape"},
      "encoding": {
        "shape":{ "field":"geo", "type": "geojson"},
        "color": {
          "field":"PercentBurnt",
          "type": "quantitative",
          "scale":{"domain": [0, 0.2], "scheme":"yelloworangered"},
          "title":["Percent", "area burnt", "in a decade"],
          
          "legend": {
            "format":"0%",
            
            "titleFont":"Lora",
            "gradientLength":340,
            "titleFontSize":16,
            "labelFontSize":12
          }
        },
        "tooltip": [
          {"field":"State", "title":"State"},
          {"field":"HectaresBurnt","title":"Hectares Burnt", "format":".3s"},
          {"field":"PercentBurnt", "title":"Percent area burnt over 10 years", "format":".2%"},
          {"field":"Decade", "title":"Decade"}
        ]
      }
    },
    {
      "data":{
        "url":"https://raw.githubusercontent.com/SeanMASilva/FIT3179-Datavis2/refs/heads/main/src/assets/populated_places.json",
        "format":{"type": "topojson", "feature": "ne_50m_populated_places_simple"}
      },
      "transform": [
        {"filter":"datum.properties.pop_min > 50000"}
      ],
      "mark": {"type": "point", "size":5, "opacity":1, "color":"black"},
      
      "encoding": {
        "latitude":{"field":"properties.latitude"},
        "longitude":{"field":"properties.longitude"}
      }
    }
  ]
}
