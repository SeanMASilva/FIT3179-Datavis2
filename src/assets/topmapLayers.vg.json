{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "layer": [
    {
      "data":{
        "url":"https://raw.githubusercontent.com/SeanMASilva/FIT3179-Datavis2/refs/heads/main/src/assets/populated_places.json",
        "format":{"type": "topojson", "feature": "ne_50m_populated_places_simple"}
      },
      "transform": [
        {"filter":"datum.properties.pop_min > 50000"}
      ],
      "mark": {"type": "text", "size":8, "opacity":1, "color":"black", "dy":0, "dx": -4, "fontWeight":100, "align":"right"},
      
      "encoding": {
        "latitude":{"field":"properties.latitude"},
        "longitude":{"field":"properties.longitude"},
        "text":{"field":"properties.name"}
      }
    },
    {
      "data":{
        "url": "https://raw.githubusercontent.com/SeanMASilva/FIT3179-Datavis2/refs/heads/main/src/assets/baseWorldLarger.json",
        "format": {"type": "topojson", "feature": "ne_50m_graticules_10"}
      },
      "mark": {"type": "geoshape", "stroke":"grey", "fill":null, "opacity":0.3}
    }
  ]
}